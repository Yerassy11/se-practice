@startuml
title Book room - Activity Diagram
start
:Student requests room and time slot;
if (Valid future start and duration > 0 and <= 2 hours? (R1)) then ([yes])
  if (Room blocked? (R3)) then ([no])
    if (Overlapping active booking for the same room? (R2)) then ([no])
      :Create booking;
      :Send booking confirmation (R4);
      stop
    else ([yes])
      :Reject booking - time slot overlaps;
      stop
    endif
  else ([yes])
    :Reject booking - room is blocked;
    stop
  endif
else ([no])
  :Reject booking - invalid time range;
  stop
endif
@enduml
